/api/*
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
/feedback/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
/calendar/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
