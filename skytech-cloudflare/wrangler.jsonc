{
  "name": "skytech-crm",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.netlify/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "skytech-crm" }
  ]
}
